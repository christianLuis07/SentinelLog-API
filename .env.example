# SentinelLog API - Environment Configuration Template
# Copy this file to .env and replace placeholders with production-grade secrets before deployment.

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=sentinellog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Full Connection String (composed for ASP.NET Core)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=sentinellog;Username=postgres;Password=CHANGE_ME_TO_STRONG_PASSWORD;

# JWT Security Settings
Jwt__Secret=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_KEY_OF_AT_LEAST_32_BYTES_LENGTH
Jwt__Issuer=SentinelLog
Jwt__Audience=SentinelLog.Client
Jwt__ExpirationMinutes=60

# Rate Limiting Controls
RateLimiting__LoginPermitLimit=5
RateLimiting__RegisterPermitLimit=10
RateLimiting__EventsPermitLimit=60

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
